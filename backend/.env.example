# Copy to backend/.env and fill in. Never commit .env.

PORT=3000
FRONTEND_URL=http://localhost:4200

# --- AI provider for the agent: set ONE of these ---
# Gemini (free tier available): aistudio.google.com/apikey - key starts with "AIza"
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Claude (prepaid API credit): console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# Optional override; otherwise Gemini is used when GEMINI_API_KEY is set, else Claude.
# AI_PROVIDER=gemini

# --- PayPal sandbox (required for checkout) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Optional: webhook id from the same app, enables verified PAYMENT.CAPTURE.* webhooks at /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Show "Continue with PayPal" (Log in with PayPal). Requires the feature enabled for your app in the
# PayPal dashboard with this server's return URL; leave off and visitors start as guests.
PAYPAL_LOGIN=off

# --- Channel3 product search (optional) ---
# Without a key BuyWise uses the bundled, clearly labelled demo catalog.
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US
ALLOW_DEMO_CATALOG=true

# --- Demo authorization PIN ---
# Seeds the PIN hash at startup. Never logged, stored in clear, or sent to the AI.
DEMO_PIN=2468
MAX_PIN_ATTEMPTS=3

# Development only: enables POST /api/dev/seed (scripted session, no Claude call). Ignored in production.
DEV_SEED=false
