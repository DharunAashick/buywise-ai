# Copy to backend/.env and fill in. Never commit .env.

PORT=3000
FRONTEND_URL=http://localhost:4200

# --- Claude (required for the agent) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# --- PayPal sandbox (required for checkout) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Optional: webhook id from the same app, enables verified PAYMENT.CAPTURE.* webhooks at /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Channel3 product search (optional) ---
# Without a key BuyWise uses the bundled, clearly labelled demo catalog.
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US
ALLOW_DEMO_CATALOG=true

# --- Demo authorization PIN ---
# Seeds the PIN hash at startup. Never logged, stored in clear, or sent to the AI.
DEMO_PIN=2468
MAX_PIN_ATTEMPTS=3

# Development only: enables POST /api/dev/seed (scripted session, no Claude call). Ignored in production.
DEV_SEED=false
